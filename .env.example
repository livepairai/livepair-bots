# LivePair API key — https://livepairai.com/settings (prepaid credits, per-result billing)
LP_KEY=lp_your_key_here

# telegram-bot.mjs — from @BotFather
BOT_TOKEN=123456:AA-example

# discord-bot.mjs — from the Discord developer portal
PUBLIC_KEY=your_app_public_key_hex
APP_ID=your_application_id
# BOT_TOKEN is only needed for the one-time command registration curl
PORT=8787
